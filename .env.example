# Which LLM backend to use: "groq" (free tier) or "anthropic" (Claude).
# If unset: anthropic when ANTHROPIC_API_KEY is set, otherwise groq.
LLM_PROVIDER=groq

# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional model override (defaults: openai/gpt-oss-120b on Groq, claude-opus-5-5 on Anthropic)
# LLM_MODEL=
